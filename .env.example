# Copy to .env and fill in. Never commit .env.
# All providers below have free tiers; leave unused ones empty.

# Which model the agent uses (LiteLLM naming): gemini/<model>, groq/<model>, ollama/<model>
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_VISION_MODEL=        # defaults to LLM_MODEL

GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Postgres (local Docker)
DATABASE_URL=postgresql://ledgerpilot:ledgerpilot@localhost:5432/ledgerpilot

# Langfuse (free Hobby plan, EU region); tracing is off when empty
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Guardrails
AUTO_BOOK_MAX_GROSS_EUR=250
RUN_MAX_TOKENS=50000
RUN_MAX_STEPS=15

# LLM client
LLM_MIN_INTERVAL_S=0   # pause between provider calls (free-tier RPM limits)
LLM_MAX_RETRIES=2      # extra attempts when output fails schema validation
LLM_CACHE_DIR=         # default .cache/llm; "off" disables the response cache
